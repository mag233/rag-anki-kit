# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as long as we don't include
# *.spec, we should be fine.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Cython debug symbols
cython_debug/

# VS Code settings
.vscode/

# Streamlit secrets
.secrets/

# Environment variables
.env
.venv

# macOS files
.DS_Store
**/.DS_Store

